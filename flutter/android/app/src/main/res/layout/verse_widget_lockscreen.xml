<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Header: Sanctuary Badge + Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_sanctuary_bible"
            android:contentDescription="@string/widget_name" />

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="@string/widget_badge_title"
            android:textColor="@color/sanctuary_gold"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textAllCaps="true" />
    </LinearLayout>

    <!-- Verse Scripture Text (Deep Navy Blue #002147) -->
    <TextView
        android:id="@+id/widget_verse_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="@string/widget_default_text"
        android:textColor="@color/sanctuary_navy"
        android:textSize="12sp"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="3"
        android:ellipsize="end"
        android:gravity="center_vertical|start" />

    <!-- Verse Reference (Soft Gold #D4AF37) -->
    <TextView
        android:id="@+id/widget_verse_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_default_reference"
        android:textColor="@color/sanctuary_gold"
        android:textSize="10sp"
        android:textStyle="bold"
        android:gravity="end" />

</LinearLayout>
