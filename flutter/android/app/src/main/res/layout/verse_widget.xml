<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:padding="16dp">

    <!-- Header: Sanctuary Badge + Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_sanctuary_bible"
            android:contentDescription="@string/widget_name" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/widget_badge_title"
            android:textColor="@color/sanctuary_gold"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textAllCaps="true" />
    </LinearLayout>

    <!-- Verse Scripture Text (Deep Navy Blue #002147) -->
    <TextView
        android:id="@+id/widget_verse_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="@string/widget_default_text"
        android:textColor="@color/sanctuary_navy"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.2"
        android:maxLines="4"
        android:ellipsize="end"
        android:gravity="center_vertical|start" />

    <!-- Subtle Gold Divider -->
    <View
        android:layout_width="32dp"
        android:layout_height="2dp"
        android:background="@drawable/widget_gold_divider"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />

    <!-- Verse Reference (Soft Gold #D4AF37) -->
    <TextView
        android:id="@+id/widget_verse_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_default_reference"
        android:textColor="@color/sanctuary_gold"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:gravity="end" />

</LinearLayout>
